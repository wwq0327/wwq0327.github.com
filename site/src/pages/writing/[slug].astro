---
import { render } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import { getWorks } from '../../lib/content';

export async function getStaticPaths() {
  const articles = (await getWorks()).filter((entry) => entry.data.type === 'article');
  return articles
    .filter((entry) => !entry.data.legacyPath)
    .map((entry) => ({
      params: { slug: entry.data.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleView entry={entry} headings={headings}>
  <Content />
</ArticleView>
