---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getActivities,
  getArticles,
  getPerson,
  getProjects,
  getWorks,
  siteHasSamples,
  workPath,
  projectPath,
} from '../lib/content';
import { activityLabels, formatDate, formatMonthDay, stageLabels } from '../lib/format';

const [person, activities, projects, articles, works, sample] = await Promise.all([
  getPerson(),
  getActivities(),
  getProjects(),
  getArticles(),
  getWorks(),
  siteHasSamples(),
]);

const workPathById = new Map(works.map((work) => [work.data.id, workPath(work)]));
const workTypeById = new Map(works.map((work) => [work.data.id, work.data.type]));

const featuredProjects = projects.filter((project) => project.data.featured);
const projectList = [
  ...featuredProjects,
  ...projects.filter((project) => !project.data.featured),
].slice(0, 3);
const featuredArticles = articles.filter((article) => article.data.featured);
const articleList = [
  ...featuredArticles,
  ...articles.filter((article) => !article.data.featured),
].slice(0, 3);
const latest = activities[0];
const recent = activities.slice(0, 4);

const [taglineFirst, taglineSecond] = person.data.tagline.split('，');

const activityHref = (related: { type: 'project' | 'work'; id: string }) =>
  related.type === 'project'
    ? `/projects/${related.id}/`
    : workPathById.get(related.id) ?? '/index/';
---

<BaseLayout current="notes" sample={sample}>
  <div class="container">
    <section class="hero">
      <div class="hero__copy">
        <p class="eyebrow">Wanqing / A Personal Field Note</p>
        <h1>
          {taglineFirst}{taglineSecond ? '，' : ''}<br />
          <em>{taglineSecond ?? ''}</em>
        </h1>
        <p class="hero__lede">
          记录正在做的项目、写下的文字和拍过的视频，也记录它们发生的时间、做到哪一步、
          还有哪些没说清的地方。
        </p>
        <div class="hero__actions">
          <a class="button" href="#recent">最近在做什么 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/index/">按时间翻全部内容</a>
        </div>
        <p class="hero__signature">
          <span>{person.data.displayName}</span>
          <small>记录，也继续。</small>
        </p>
      </div>

      <div class="paper-stack">
        <div class="sheet sheet--back" aria-hidden="true"></div>
        <div class="sheet sheet--mid" aria-hidden="true"></div>
        <div class="sheet sheet--front">
          <div class="paper-stack__head">
            <span class="paper-stack__label">最近一次更新</span>
            {latest && <span class="paper-stack__date">{formatDate(latest.data.occurredAt)}</span>}
          </div>
          <span class="paper-stack__tab" aria-hidden="true">近况手记</span>
          {latest ? (
            <>
              <p class="paper-stack__quote">{latest.data.summary}</p>
              <p class="paper-stack__meta">
                {activityLabels[latest.data.kind]}
              </p>
              <a class="paper-stack__link" href={activityHref(latest.data.related)}>
                查看这条记录 <span aria-hidden="true">↗</span>
              </a>
            </>
          ) : (
            <p class="paper-stack__quote">还没有记录可展示的变更。</p>
          )}
        </div>
      </div>
    </section>

    <div class="recent-grid">
      <section class="recent-notes" id="recent">
        <div class="section-head">
          <div>
            <p class="eyebrow">Recent Notes</p>
            <h2>最近发生</h2>
          </div>
          <a href="/index/">按时间翻全部</a>
        </div>

        {recent.length > 0 ? (
          <ol class="recent-list">
            {recent.map((activity) => (
              <li class="recent-note">
                <div class="recent-note__date">
                  <span class="recent-note__year">{activity.data.occurredAt.slice(0, 4)}</span>
                  <span class="recent-note__monthday">{formatMonthDay(activity.data.occurredAt)}</span>
                </div>
                <div class="recent-note__body">
                  <span class="recent-note__kind">{activityLabels[activity.data.kind]}</span>
                  <p class="recent-note__title">
                    <a href={activityHref(activity.data.related)}>{activity.data.summary}</a>
                  </p>
                  <a class="recent-note__link" href={activityHref(activity.data.related)}>
                    {activity.data.related.type === 'project'
                      ? '项目详情与限制'
                      : workTypeById.get(activity.data.related.id) === 'video'
                        ? '打开视频'
                        : '阅读全文'}{' '}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="page-header__lede">还没有动态。等有真实变更时再记录，不用占位内容填充。</p>
        )}
      </section>

      <aside class="ongoing" aria-labelledby="ongoing-title">
        <p class="eyebrow">Ongoing / 正在做的</p>
        <h2 id="ongoing-title">在做的项目</h2>
        <ul class="ongoing__list">
          {projectList.map((project) => (
            <li>
              <a href={projectPath(project)}>
                <span class="ongoing__title">{project.data.title}</span>
                <span class="ongoing__stage">{stageLabels[project.data.stage]}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="ongoing__note">相关方向各自独立，不代表已经集成，也不代表教学效果已被验证。</p>
        <a class="text-link" href="/projects/">全部项目</a>
      </aside>
    </div>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>最近写的</h2>
        </div>
        <a href="/writing/">全部文字</a>
      </div>
      <ul class="writing-grid">
        {articleList.map((article) => (
          <li class="writing-card">
            <a href={workPath(article)}>
              <span class="writing-card__meta">
                {formatDate(article.data.dates.published ?? article.data.dates.authored)}
              </span>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="letter-ribbon">
      <div class="letter-ribbon__copy">
        <p class="eyebrow">Let's Stay in Touch</p>
        <h2>偶尔写一封更新信</h2>
      </div>
      <div class="letter-ribbon__body">
        <p>
          只在有值得说明的项目或文章时发送，不转发广告，也不会把你的地址交给第三方。
          订阅功能目前尚未接入，这里先说明计划，不假装已经能用。
        </p>
        <a class="button" href="/subscribe/">看看订阅说明 <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
