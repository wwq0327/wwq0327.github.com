---
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, siteHasSamples } from '../../lib/content';

const [articles, sample] = await Promise.all([getArticles(), siteHasSamples()]);
const perPage = 20;
const totalPages = Math.max(1, Math.ceil(articles.length / perPage));
const current = articles.slice(0, perPage);
---

<BaseLayout
  title="文字"
  description={`写下的文章与笔记，共 ${articles.length} 篇；保留原稿日期，区分发布时间与修订时间。`}
  current="writing"
  sample={sample}
>
  <WritingList articles={current} page={1} totalPages={totalPages} />
</BaseLayout>
