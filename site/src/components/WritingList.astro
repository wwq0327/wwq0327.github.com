---
import type { WorkEntry } from '../lib/content';
import EntryList from './EntryList.astro';
import Pagination from './Pagination.astro';

interface Props {
  articles: WorkEntry[];
  page: number;
  totalPages: number;
  total: number;
}

const { articles, page, totalPages, total } = Astro.props;
---

<div class="container">
  <header class="page-header">
    <p class="eyebrow">Writing</p>
    <h1>文字</h1>
    <p class="page-header__lede">
      当前站内收录 {total} 篇，按时间倒序排列；有发布日期的按发布，只有写作日期的按写作。
    </p>
    <p class="page-header__links">
      <a href="/topics/">按主题浏览</a>
      <span aria-hidden="true">·</span>
      <a href="/archive/">按年份浏览</a>
    </p>
  </header>

  {articles.length > 0 ? (
    <EntryList articles={articles} start={(page - 1) * 20 + 1} />
  ) : (
    <p class="page-header__lede">还没有可展示的文章。</p>
  )}

  <Pagination
    page={page}
    totalPages={totalPages}
    firstHref="/writing/"
    base="/writing/page/"
    label="文字分页"
  />
</div>
