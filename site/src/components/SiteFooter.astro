---
import { getPerson } from '../lib/content';

const person = await getPerson();
const platformLabels: Record<string, string> = {
  github: 'GitHub',
  weibo: '微博',
  bilibili: 'B站',
  x: 'X',
  youtube: 'YouTube',
  wechat: '公众号',
  'wechat-channels': '视频号',
  email: '邮箱',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__signature">
        <a class="footer-wordmark" href="/" aria-label="回到首页">
          {person.data.displayName}<span aria-hidden="true">↗</span>
        </a>
        <p class="site-footer__tagline">{person.data.tagline}</p>
      </div>
      <ul class="site-footer__links">
        {person.data.accounts.map((account) => (
          <li>
            {account.url ? (
              <a
                href={account.url}
                rel="me noopener"
                target={account.platform === 'email' ? undefined : '_blank'}
              >
                {platformLabels[account.platform] ?? account.label}
              </a>
            ) : (
              <a
                href="/about/#wechat"
                title={`${account.label}：${account.handle ?? ''}（微信内搜索）`}
              >
                {platformLabels[account.platform] ?? account.label}
              </a>
            )}
          </li>
        ))}
        <li><a href="/index/">内容索引</a></li>
        <li><a href="/ai/">给 AI 的入口</a></li>
        <li><a href="/subscribe/">订阅更新</a></li>
      </ul>
    </div>
    <p class="site-footer__note">
      这里记录正在做的项目、写下的文字和拍过的视频。更新以实际发生的变更为准，
      未被核实的进展不写成已完成。
    </p>
    <div class="site-footer__bottom">
      <span>© 2026 {person.data.displayName}</span>
      <span>文字与图片未经说明均为本人所有；引用请注明来源。</span>
    </div>
  </div>
</footer>
