---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPerson, siteHasSamples } from '../lib/content';

const [person, sample] = await Promise.all([getPerson(), siteHasSamples()]);
const { Content } = await render(person);
const isExternal = (url: string | null) => Boolean(url?.startsWith('http'));
const searchOnly = person.data.accounts.filter((account) => !account.url);
---

<BaseLayout
  title="关于"
  description="关于 wanqing：语文老师、写作、视频与 AI 实践，以及这个网站的记录方式。"
  current="about"
  sample={sample}
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">About</p>
      <h1>关于</h1>
      <p class="page-header__lede">
        这一页写我是谁、关心什么，以及这个站为什么这样记录。
      </p>
    </header>

    {person.data.reviewStatus === 'draft' && (
      <div class="notice">
        <strong>待本人确认</strong><br />
        站点名称与联系入口已确认；简介待本人复核后再定稿。
      </div>
    )}

    <div class="about-grid">
      <article class="prose">
        <Content />
      </article>

      <aside class="facts">
        <h2>联系入口</h2>
        <ul class="accounts">
          {person.data.accounts.map((account) => (
            <li>
              {account.url ? (
                <a
                  href={account.url}
                  rel={isExternal(account.url) ? 'me noopener' : undefined}
                  target={isExternal(account.url) ? '_blank' : undefined}
                >
                  {account.label}
                </a>
              ) : (
                <span class="accounts__name">{account.label}</span>
              )}
              <span>{account.handle ?? ''}</span>
            </li>
          ))}
        </ul>
        {searchOnly.length > 0 && (
          <p class="accounts__note">
            微信公众号与视频号同名，都叫<span class="nowrap">「万十二先生」</span>；公众号主要写 AI 与教学，也写阅读、写作中的尝试。可在微信内搜索名称。
          </p>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
