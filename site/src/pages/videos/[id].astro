---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getProjects,
  getVideos,
  projectPath,
  siteHasSamples,
} from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const videos = await getVideos();
  return videos.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const video = entry.data;
const { Content } = await render(entry);

const [projects, sample] = await Promise.all([getProjects(), siteHasSamples()]);
const relatedProjects = projects.filter((project) =>
  video.relatedProjectIds.includes(project.data.id),
);

function clock(seconds: number): string {
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return `${minutes}:${String(rest).padStart(2, '0')}`;
}
---

<BaseLayout title={video.title} description={video.summary} current="videos" sample={sample}>
  <div class="container">
    <a class="back-link" href="/videos/">← 返回视频</a>

    <header class="detail-header">
      <div class="detail-meta">
        <span>视频</span>
        <span>{formatDate(video.dates.published ?? video.dates.authored)}</span>
        {video.media?.durationSeconds && (
          <span>时长 {clock(video.media.durationSeconds)}</span>
        )}
        {video.visibility === 'sample' && <span class="badge badge--sample">示例</span>}
      </div>
      <h1>{video.title}</h1>
      <p class="detail-header__summary">
        <span class="summary-label">摘要</span>
        {video.summary}
      </p>
      <div class="detail-meta">
        <a href={video.originalUrl} rel="noopener" target="_blank">
          观看入口 · {video.platform}
        </a>
      </div>
    </header>

    <div class="detail-grid">
      <article>
        <div class="prose">
          <Content />
        </div>

        {video.media && video.media.chapters.length > 0 && (
          <section class="section">
            <div class="section-head">
              <h2>章节</h2>
            </div>
            <ol class="timeline">
              {video.media.chapters.map((chapter) => (
                <li class="timeline__item">
                  <span class="timeline__date">{clock(chapter.startSeconds)}</span>
                  <div>
                    <p class="timeline__summary">{chapter.title}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </article>

      <aside class="facts">
        <h2>这条视频</h2>
        <dl>
          <dt>类型</dt>
          <dd>视频</dd>
          <dt>平台</dt>
          <dd>
            <a href={video.originalUrl} rel="noopener" target="_blank">{video.platform}</a>
          </dd>
          <dt>时长</dt>
          <dd>
            {video.media?.durationSeconds ? clock(video.media.durationSeconds) : '待补'}
          </dd>
          {relatedProjects.length > 0 && (
            <>
              <dt>相关项目</dt>
              <dd>
                <ul>
                  {relatedProjects.map((project) => (
                    <li><a href={projectPath(project)}>{project.data.title}</a></li>
                  ))}
                </ul>
              </dd>
            </>
          )}
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>
