{
  "name": "wanqing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && tsx scripts/check-rendered.ts && node scripts/check-feeds.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:rendered": "tsx scripts/check-rendered.ts",
    "validate": "tsx scripts/validate-content.ts",
    "test": "tsx --test scripts/*.test.ts",
    "check:links": "node scripts/check-external-links.mjs",
    "check:feeds": "node scripts/check-feeds.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "astro": "7.3.8",
    "image-size": "2.0.2",
    "remark-cjk-friendly": "2.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^22.20.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  }
}
