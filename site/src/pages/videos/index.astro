---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPerson, getVideos, siteHasSamples, workPath } from '../../lib/content';
import { formatDate } from '../../lib/format';

const [videos, sample, person] = await Promise.all([
  getVideos(),
  siteHasSamples(),
  getPerson(),
]);
const channels = person.data.accounts.filter((account) =>
  ['bilibili', 'youtube'].includes(account.platform),
);

function duration(seconds: number | null): string {
  if (!seconds) return '时长待补';
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return `${minutes}:${String(rest).padStart(2, '0')}`;
}
---

<BaseLayout
  title="视频"
  description="视频入口：B站与 YouTube；站内视频目录还在整理。"
  current="videos"
  sample={sample}
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Videos</p>
      <h1>视频</h1>
      <p class="page-header__lede">
        视频主要发在 B站 和 YouTube。站内先放平台入口；等有可逐条核对的成片，再补上标题、日期和章节。
      </p>
    </header>

    <section class="channel-block" aria-labelledby="video-channels">
      <div class="channel-block__head">
        <div>
          <p class="eyebrow">Channels</p>
          <h2 id="video-channels">视频更新在 B站 和 YouTube</h2>
        </div>
        <p>站内视频目录还在整理；下面两个主页是最直接的入口。</p>
      </div>
      <div class="channel-grid">
        {channels.map((channel) => (
          <a
            class="channel-card"
            href={channel.url}
            target="_blank"
            rel="me noopener"
          >
            <span class="channel-card__label">{channel.label}</span>
            <span class="channel-card__handle">
              {channel.handle ?? '打开主页'}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {videos.length > 0 ? (
      <ol class="entry-list">
        {videos.map((video) => (
          <li class="entry">
            <div class="entry__aside">
              <div>{formatDate(video.data.dates.published ?? video.data.dates.authored)}</div>
              <div>{duration(video.data.media?.durationSeconds ?? null)}</div>
              {video.data.visibility === 'sample' && (
                <div><span class="badge badge--sample">示例</span></div>
              )}
            </div>
            <div class="entry__body">
              <h2><a href={workPath(video)}>{video.data.title}</a></h2>
              <p>{video.data.summary}</p>
              {video.data.media && video.data.media.chapters.length > 0 && (
                <div class="entry__tags">
                  <span class="badge">{video.data.media.chapters.length} 个章节</span>
                  <span class="badge">{video.data.platform}</span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="page-header__lede">
        有可逐条校对的视频后，会把标题、日期和章节列在这里。
      </p>
    )}
  </div>
</BaseLayout>
