---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTopics, siteHasSamples, topicPath } from '../../lib/content';

const [topics, sample] = await Promise.all([getTopics(), siteHasSamples()]);
const major = topics.filter((topic) => topic.count >= 2);
const minor = topics.filter((topic) => topic.count === 1);
const groups = [
  { title: 'AI 与工具', names: ['AI', 'AI工具', 'Builders', '技术动态', 'WorkBuddy', 'AI时代', '工具', 'Anthropic', 'Gemini', 'OpenClaw'] },
  { title: '写作与阅读', names: ['写作', '阅读', '记录', '公众号', '学习方法'] },
  { title: '工作与效率', names: ['效率', '工作流', '教师', '行动力'] },
  { title: '历史与古代', names: ['明史', '古代日常', '明史切片'] },
];
const grouped = groups
  .map((group) => ({ ...group, topics: major.filter((topic) => group.names.includes(topic.name)) }))
  .filter((group) => group.topics.length > 0);
const groupedNames = new Set(grouped.flatMap((group) => group.topics.map((topic) => topic.name)));
const remaining = major.filter((topic) => !groupedNames.has(topic.name));
---

<BaseLayout
  title="主题"
  description="按主题浏览站内文章：AI、写作、效率、历史、教学与工具等。"
  current="topics"
  sample={sample}
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Topics</p>
      <h1>主题</h1>
      <p class="page-header__lede">
        按文章里标注的主题聚合；明确同义的标签已合并到主主题。
        同一个主题下按时间倒序，也可以<a href="/archive/">按年份浏览</a>。
      </p>
    </header>

    <section class="section" aria-labelledby="major-topics">
      <div class="section-head">
        <h2 id="major-topics">常读主题</h2>
        <p>{major.length} 个主题 · {grouped.length + (remaining.length ? 1 : 0)} 组</p>
      </div>
      {grouped.map((group) => (
        <div class="topic-group">
          <h3>{group.title}</h3>
          <ul class="topic-grid">
            {group.topics.map((topic) => (
              <li>
                <a class="topic-card" href={topicPath(topic.name)}>
                  <span class="topic-card__name">{topic.name}</span>
                  <span class="topic-card__count">{topic.count} 篇</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {remaining.length > 0 && (
        <div class="topic-group">
          <h3>其他</h3>
          <ul class="topic-grid">
            {remaining.map((topic) => (
              <li>
                <a class="topic-card" href={topicPath(topic.name)}>
                  <span class="topic-card__name">{topic.name}</span>
                  <span class="topic-card__count">{topic.count} 篇</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    {minor.length > 0 && (
      <details class="topic-more">
        <summary>其余 {minor.length} 个主题</summary>
        <ul class="topic-chips">
          {minor.map((topic) => (
            <li><a class="badge" href={topicPath(topic.name)}>{topic.name}</a></li>
          ))}
        </ul>
      </details>
    )}
  </div>
</BaseLayout>
