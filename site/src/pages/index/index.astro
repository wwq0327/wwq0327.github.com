---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexList from '../../components/IndexList.astro';
import { getIndexEntries, siteHasSamples } from '../../lib/content';

const perPage = 30;
const [entries, sample] = await Promise.all([getIndexEntries(), siteHasSamples()]);
const totalPages = Math.max(1, Math.ceil(entries.length / perPage));
---

<BaseLayout
  title="内容索引"
  description="站内全部可见内容的文字索引，按时间倒序，支持分页与主题、年份浏览。"
  current="index"
  sample={sample}
>
  <IndexList
    entries={entries.slice(0, perPage)}
    page={1}
    totalPages={totalPages}
    total={entries.length}
  />
</BaseLayout>
